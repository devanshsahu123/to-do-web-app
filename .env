# Backend API URL - Change this single line to update the backend URL for the entire app!
# For Localhost: REACT_APP_API_URL=http://localhost:3002
# For Production: REACT_APP_API_URL=https://sahusaathi.com

# Disables Webpack Dev Server Host header check when running behind a reverse proxy (e.g. Nginx)
DANGEROUSLY_DISABLE_HOST_CHECK=true
REACT_APP_API_URL=https://sahusaathi.com

# Disables Webpack Dev Server Host header check when running behind a reverse proxy (e.g. Nginx)
DANGEROUSLY_DISABLE_HOST_CHECK=true
